{
  "name": "williamzujkowski-site",
  "type": "module",
  "version": "2.0.0",
  "description": "Personal website of William Zujkowski — Astro 7 + Svelte 5",
  "author": "William Zujkowski",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_ENV=production astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "audit:remarque": "node scripts/run-remarque-audit.mjs",
    "audit:typography": "node scripts/typography-audit.mjs",
    "audit:colors": "node scripts/color-token-audit.mjs",
    "audit:accent-font": "node scripts/accent-font-audit.mjs",
    "audit:apca": "node scripts/apca-audit.mjs",
    "audit:grain": "node scripts/grain-contrast-audit.mjs",
    "audit": "pnpm audit:remarque && pnpm audit:typography && pnpm audit:colors && pnpm audit:accent-font && pnpm audit:apca",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.4",
    "cookie": "^2.0.1",
    "markdown-it": "^15.0.0",
    "remarque-tokens": "^0.26.0",
    "sanitize-html": "^2.17.7",
    "satori": "^0.31.0",
    "svelte": "^5.56.9",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.67.0",
    "apca-w3": "^0.1.9",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.4.3"
  },
  "overrides": {
    "fast-xml-parser": ">=5.5.8",
    "fast-xml-builder": ">=1.1.7",
    "uuid": ">=11.1.1",
    "dompurify": ">=3.4.11",
    "vite": ">=8.0.13",
    "esbuild": ">=0.28.1"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.8",
      "fast-xml-builder": ">=1.1.7",
      "uuid": ">=11.1.1",
      "dompurify": ">=3.4.11",
      "vite": ">=8.0.13",
      "esbuild": ">=0.28.1",
      "yaml@<2.8.3": ">=2.8.3",
      "brace-expansion@5": ">=5.0.6"
    }
  }
}
