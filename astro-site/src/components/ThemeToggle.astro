---
// Dark/light toggle — 2-state with system detection on first visit
// Shift+click resets to OS-synced mode
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch to dark theme"
  title="Toggle theme"
  class="theme-toggle"
>
  <svg class="theme-icon theme-icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg class="theme-icon theme-icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    color: var(--color-muted);
    transition: color 150ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    position: relative;
    width: 2.75rem;    /* 44px — USWDS touch target minimum */
    height: 2.75rem;
  }

  .theme-toggle:hover {
    color: var(--color-fg);
  }

  .theme-icon {
    position: absolute;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  /* Light mode: show sun (click to go dark), hide moon */
  .theme-icon--sun { opacity: 1; transform: scale(1); }
  .theme-icon--moon { opacity: 0; transform: scale(0.8); }

  /* Dark mode: show moon, hide sun */
  :root.dark .theme-icon--sun { opacity: 0; transform: scale(0.8); }
  :root.dark .theme-icon--moon { opacity: 1; transform: scale(1); }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) .theme-icon--sun { opacity: 0; transform: scale(0.8); }
    :root:not(.light) .theme-icon--moon { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icon { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    // An explicit choice applies for this page even when persistence fails.
    let themeOverride;

    // localStorage can throw (blocked cookies, some private modes) — treat
    // failed reads as "no stored preference" and skip failed writes.
    function storedTheme() {
      if (themeOverride !== undefined) return themeOverride;
      try { return localStorage.theme; } catch { return undefined; }
    }
    function storeTheme(value) {
      themeOverride = value;
      try {
        if (value === null) localStorage.removeItem('theme');
        else localStorage.theme = value;
      } catch { /* no persistence */ }
    }

    function isDark() {
      const t = storedTheme();
      if (t === 'dark') return true;
      if (t === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    // The static theme-color metas in BaseLayout only know the OS scheme, so
    // a reader who toggles or picks a deck got browser chrome in the other
    // palette. Mirror the live page background into them. Read --color-bg
    // from body rather than body's background-color: during the crossfade
    // the latter is mid-transition, the token is already final. Converted
    // to hex through a canvas because the token is oklch() and theme-color
    // support for it is uneven across browsers.
    function syncThemeColor() {
      const metas = document.querySelectorAll('meta[name="theme-color"]');
      if (!metas.length) return;
      // Resolve through a probe, not the token text: a deck palette's
      // --color-bg is light-dark(...), which only the cascade resolves (and
      // a transition-free probe never reads a mid-crossfade value).
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;transition:none;background-color:var(--color-bg)';
      document.body.appendChild(probe);
      const bg = getComputedStyle(probe).backgroundColor;
      probe.remove();
      const ctx = bg && document.createElement('canvas').getContext('2d');
      if (!ctx) return;
      const sentinel = '#010203';
      ctx.fillStyle = sentinel;
      ctx.fillStyle = bg;
      if (ctx.fillStyle === sentinel) return; // unparseable: keep the no-JS defaults
      ctx.fillRect(0, 0, 1, 1);
      const px = ctx.getImageData(0, 0, 1, 1).data;
      const hex = '#' + [px[0], px[1], px[2]].map(function (v) { return v.toString(16).padStart(2, '0'); }).join('');
      metas.forEach(function (m) { m.setAttribute('content', hex); });
    }

    function applyTheme() {
      applyThemeClasses();
      syncThemeColor();
    }

    function applyThemeClasses() {
      const root = document.documentElement;
      const dark = isDark();
      const t = storedTheme();

      root.classList.remove('dark', 'light');
      if (t === 'dark') root.classList.add('dark');
      else if (t === 'light') root.classList.add('light');
      // If no localStorage, CSS @media handles it

      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        btn.setAttribute('title', 'Toggle theme');
      }
    }

    // Theme crossfade (issue #274 item 3) — armed ONLY here, on a deliberate
    // click. Never called from applyTheme()/init(), so first paint and the
    // localStorage-restore path (head script in BaseLayout.astro) never see
    // this class. The CSS transition itself is also gated behind
    // prefers-reduced-motion (see global.css), but skipping the reflow+
    // timeout here too avoids pointless work for those users.
    function triggerCrossfade() {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const root = document.documentElement;
      // Single pending cleanup: rapid switches must not strip the class early.
      if (window.__themeFadeT) clearTimeout(window.__themeFadeT);
      root.classList.add('theme-transition');
      void root.offsetHeight; // force reflow: arm the transition before classes below change color tokens
      window.__themeFadeT = window.setTimeout(function () { root.classList.remove('theme-transition'); }, 250);
    }

    function toggle(e) {
      // A deck palette (data-palette) is paired: it follows this toggle
      // through light-dark(), so toggling never has to exit it.
      const dark = isDark();
      triggerCrossfade();

      // Shift+click resets to system/OS preference
      if (e.shiftKey) {
        storeTheme(null);
        applyTheme();
        return;
      }

      storeTheme(dark ? 'light' : 'dark');
      applyTheme();
    }

    function init() {
      applyTheme();
      // A palette pick changes --color-bg: keep the theme-color metas in step.
      document.addEventListener('remarque-palette-changed', applyTheme);
      // CSS follows OS changes immediately; keep the action label alongside it.
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      if (systemTheme.addEventListener) systemTheme.addEventListener('change', applyTheme);
      else systemTheme.addListener(applyTheme);
      const btn = document.getElementById('theme-toggle');
      if (btn) btn.addEventListener('click', toggle);
    }

    // Every navigation is a full page load (no ClientRouter), so a single
    // run on script execution is enough — no astro:after-swap needed.
    init();
  })();
</script>
