---
// Presentation (mono voice, small caps, disclosure marker, sticky rail at
// >=80rem) comes from remarque-tokens/essay.css's `.remarque-toc-rail` rules
// (imported in global.css) — issue #378.
//
// Breakpoint behavior (issue #438): the static baseline is `<details open>`,
// which is the correct no-JS fallback essay.css documents — an expanded rail
// at >=80rem, and an expandable (but open-by-default) block below it. The
// no-JS default alone left the TOC expanded on mobile, which reads as noise
// above the article. So we layer a tiny progressive-enhancement inline script
// (essay.css's header comment calls this exact approach "what the flagship
// does"): it clears `open` below the 80rem rail breakpoint and restores it
// at/above, syncing on breakpoint crossings via matchMedia. Readers without
// JS keep the fully-static `<details open>` behavior; readers with JS get a
// collapsed TOC on phones and the expanded rail on wide screens. We
// deliberately do NOT chase a CSS-only force-open — a closed <details> is not
// reliably re-openable via CSS on modern Chromium (`::details-content`
// content-visibility), so the enhancement is the robust path.

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth <= 3);
const showToc = filteredHeadings.length >= 3;
---

{
  showToc && (
    <nav class="remarque-toc-rail" aria-label="Table of contents">
      <details open>
        <summary>On this page</summary>
        <ul>
          {filteredHeadings.map((heading) => (
            <li style={`padding-left: ${(heading.depth - 2) * 1}rem`}>
              <a href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <script is:inline>
        (function () {
          var s = document.currentScript;
          var details = s && s.parentElement && s.parentElement.querySelector('details');
          if (!details || !window.matchMedia) return;
          var mq = window.matchMedia('(min-width: 80rem)');
          function sync(e) { details.open = e.matches; }
          sync(mq);
          if (mq.addEventListener) mq.addEventListener('change', sync);
          else if (mq.addListener) mq.addListener(sync);
        })();
      </script>
    </nav>
  )
}
