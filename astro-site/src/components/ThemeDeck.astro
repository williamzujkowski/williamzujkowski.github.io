---
// Theme deck: reader-selectable terminal palettes for the whole site, built
// by remarque-deck (remarque-tokens 0.31+) from @williamzujkowski/oklch-
// terminal-themes into public/palettes/ (scripts/build-palette-deck.mjs).
// Every palette is a light/dark PAIR that follows the theme toggle; the
// site's own palette ("Field Notes") stays the default. This is remarque's
// popover picker (.remarque-deck-picker--popover, 0.32): native radios,
// a height-capped panel, a bottom sheet under 40rem; remarque-tokens/deck
// applies the pick and, with dismissible, closes it on Escape / outside click.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const manifest = JSON.parse(readFileSync(join(process.cwd(), 'public', 'palettes', 'deck.json'), 'utf8'));
const palettes: { name: string; label: string }[] = manifest.palettes;
---

<details class="remarque-deck-picker remarque-deck-picker--popover theme-deck" id="theme-deck">
  <summary aria-label="Theme: choose a terminal color palette" title="Theme: choose a terminal color palette">
    <span class="deck-mini" aria-hidden="true">
      {/* Live tokens, deliberately: the mini swatch previews the ACTIVE palette. */}
      <span class="deck-mini-chip" style="background: var(--color-accent)"></span>
      <span class="deck-mini-chip" style="background: var(--color-fg)"></span>
      <span class="deck-mini-chip" style="background: var(--color-bg-subtle)"></span>
    </span>
    <span class="deck-label" aria-hidden="true">Theme</span>
  </summary>

  <fieldset>
    <legend class="sr-only">Site color theme</legend>
    <label class="remarque-deck-option deck-option">
      <input type="radio" name="remarque-palette" value="" checked />
      <span class="remarque-deck-swatches" data-palette-swatch="default" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="deck-name">Field Notes <span class="deck-tag">default</span></span>
    </label>
    {palettes.map((p) => (
      <label class="remarque-deck-option deck-option">
        <input type="radio" name="remarque-palette" value={p.name} />
        <span class="remarque-deck-swatches" data-palette-swatch={p.name} aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="deck-name">{p.label}</span>
      </label>
    ))}
    <p class="deck-credit">
      Palettes from <a href="https://github.com/williamzujkowski/oklch-terminal-themes">oklch&#8209;terminal&#8209;themes</a>
      (<a href="/about/#theme-credits">credits</a>) · each follows light/dark
    </p>
  </fieldset>
</details>

<style>
  /* The panel, the options, the swatches, the bottom sheet under 40rem and
     the height cap all come from remarque-tokens/chrome
     (.remarque-deck-picker--popover, 0.32). What is left here is the zine
     skin: the tilted live-token mini swatch, a surface and a shadow. The
     wobbly radius lives in zine.css. */
  .theme-deck { font-size: var(--text-meta); }

  .theme-deck summary {
    gap: var(--space-2);
    padding-inline: 0.35rem;
    border-radius: 0.25rem;
  }
  .deck-mini {
    display: inline-flex;
    gap: 2px;
    transform: rotate(-6deg); /* a zine-appropriate tilt */
  }
  .deck-mini-chip {
    width: 0.55rem;
    height: 0.9rem;
    border-radius: 2px 1px 3px 1px / 1px 3px 1px 2px;
    border: 1px solid var(--color-border-bold);
  }
  /* A word beside the chips so the control reads as "themes" (design review
     2026-10, G2). Dropped on phones, where the masthead row is full. */
  .deck-label { display: none; }
  @media (min-width: 40.0625rem) {
    .deck-label { display: inline; }
  }

  .theme-deck fieldset {
    min-inline-size: 0; /* a <fieldset> defaults to min-content width */
    background: var(--color-bg);
    box-shadow: 0 4px 16px var(--color-shadow);
  }
  .deck-tag { color: var(--color-muted); }
  .deck-credit {
    grid-column: 1 / -1;
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
  }
  @media (max-width: 40rem) {
    .theme-deck fieldset { box-shadow: 0 -4px 24px var(--color-shadow); }
  }
</style>

<script define:vars={{ names: palettes.map((p) => p.name) }}>
  window.__themeDeck = { names };
</script>
<script>
  import { createDeck, bindPicker } from 'remarque-tokens/deck';

  const { names } = (window as unknown as { __themeDeck: { names: string[] } }).__themeDeck;
  const picker = document.getElementById('theme-deck') as HTMLDetailsElement | null;

  // Theme crossfade (issue #274 item 3): armed only on a deliberate pick,
  // never at first paint (the head script never touches this class).
  // Mirrors ThemeToggle.astro's helper of the same name.
  function triggerCrossfade() {
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
    const root = document.documentElement;
    const w = window as unknown as { __themeFadeT?: number };
    if (w.__themeFadeT) clearTimeout(w.__themeFadeT);
    root.classList.add('theme-transition');
    void root.offsetHeight;
    w.__themeFadeT = window.setTimeout(() => root.classList.remove('theme-transition'), 250);
  }

  if (picker) {
    // Registered before bindPicker's own listeners, so the fade arms first.
    picker.querySelectorAll('input[type="radio"]').forEach((r) => r.addEventListener('change', triggerCrossfade));
    const deck = createDeck(names);
    deck.restore();
    // dismissible: Escape (focus returns to the summary) and an outside
    // click close the popover. remarque 0.32 owns that now.
    bindPicker(deck, picker, {
      dismissible: true,
      onChange() {
        document.dispatchEvent(new CustomEvent('remarque-palette-changed'));
      },
    });
  }
</script>
