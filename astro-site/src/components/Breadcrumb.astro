---
// Breadcrumb: remarque's chrome-module markup (nav.remarque-breadcrumb > ol),
// replacing the hand-rolled "Front / Dispatches" line. The last item is the
// current page: aria-current="page", not a link. Separators are generated by
// remarque-tokens/chrome with empty alt text, so a screen reader hears a list
// of items rather than the word "slash".
interface Crumb {
  label: string;
  /** Omit on the last item: the current page is text, not a link. */
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="remarque-breadcrumb site-breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* Same column and rhythm the hand-rolled .post-breadcrumb had. */
  .site-breadcrumb {
    max-width: var(--content-reading);
    margin-inline: auto;
    margin-block-end: var(--space-6);
  }
  /* A long post title must not turn the crumb into a paragraph: the ancestors
     keep their size and the current page takes the rest of the line, with an
     ellipsis. The full title is the page's h1 directly below. */
  .site-breadcrumb ol { flex-wrap: nowrap; }
  /* display: flex on every item: the markup's whitespace around a link would
     otherwise render as a space after the generated separator. */
  .site-breadcrumb li { display: flex; white-space: nowrap; flex: none; }
  .site-breadcrumb li:last-child { flex: 0 1 auto; min-width: 0; }
  .site-breadcrumb [aria-current='page'] {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
