---
import '@/styles/global.css';
import '@/styles/zine.css'; // zine marginalia layer — last, decorates both
import { Font } from 'astro:assets';
import { SECTIONS, SITE_CONFIG } from '@/lib/siteConfig';
import { humanTag } from '@/lib/utils';
import SearchTrigger from '@components/SearchTrigger.astro';
import CodeCopy from '@components/CodeCopy.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import ThemeDeck from '@components/ThemeDeck.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  wordCount?: number;
  tags?: string[];
  noindex?: boolean;
  searchIndex?: boolean;
}

const {
  title,
  description: rawDescription,
  image = '/assets/images/og/default-og.png',
  ogImage,
  type = 'website',
  publishedDate,
  wordCount,
  tags = [],
  noindex = false,
  searchIndex = true,
} = Astro.props;

// `||` (not a default param) so an empty-string description also falls back.
const description =
  rawDescription ||
  'Senior Information Security Engineer with 15+ years experience in cybersecurity, AI security, and Zero-Trust architectures.';
const siteTitle = SITE_CONFIG.author;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE_CONFIG.siteUrl;
const pageTitle = title === 'Home' || title === siteTitle ? siteTitle : `${title} - ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage ?? image, siteUrl).href;
const currentYear = new Date().getFullYear();

// Build breadcrumb items from URL path. Top-level segments take their
// masthead label (/posts/ is "Dispatches", not "Posts"), so the schema names
// match the visible breadcrumb and the nav. Tag pages sit under Dispatches,
// as their visible breadcrumb and nav highlight say.
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const sectionLabel = (href: string) => SECTIONS.find((s) => s.href === href)?.label;
const breadcrumbItems = [
  { name: 'Front', url: `${siteUrl}/` },
  ...(pathSegments[0] === 'tags' ? [{ name: 'Dispatches', url: `${siteUrl}/posts/` }] : []),
  ...pathSegments.map((segment, i) => ({
    // humanTag, not a bare title-case: the tag pages render <h1>AI</h1> via
    // humanTag() while this emitted "Ai" into the breadcrumb schema for the
    // same page. 37 of 115 tag pages disagreed with their own <h1> (Ai,
    // Ebpf, Llm, Iot, Cve, Devops, Mcp), and it is visible in Google
    // breadcrumb rich results. Two capitalisation functions, one unaware of
    // the other -- the same shape as issue #506.
    name: (i === 0 && sectionLabel(`/${segment}/`)) || humanTag(segment),
    url: `${siteUrl}/${pathSegments.slice(0, i + 1).join('/')}/`,
  })),
];

// Structured data
const authorSchema = {
  '@type': 'Person' as const,
  name: SITE_CONFIG.author,
  url: `${siteUrl}/about/`,
  sameAs: [SITE_CONFIG.social.github, SITE_CONFIG.social.linkedin],
};

const jsonLdSchemas = [];

if (type === 'article') {
  const blogPosting: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: publishedDate?.toISOString(),
    author: authorSchema,
    publisher: authorSchema,
    url: canonicalUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  };
  if (wordCount) blogPosting.wordCount = wordCount;
  if (ogImage || image !== '/assets/images/og/default-og.png') {
    blogPosting.image = {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: 1200,
      height: 630,
    };
  }
  if (tags.length > 0) blogPosting.keywords = tags.filter((t) => t !== 'posts').join(', ');
  jsonLdSchemas.push(blogPosting);
} else {
  const websiteSchema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteTitle,
    description,
    url: siteUrl,
    author: authorSchema,
  };
  jsonLdSchemas.push(websiteSchema);
}

// Breadcrumb schema (all pages except homepage)
if (pathSegments.length > 0) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: i === 0 ? item.name : type === 'article' && i === breadcrumbItems.length - 1 ? title : item.name,
      item: item.url,
    })),
  });
}

import { getSiteStats } from '@/lib/siteStats';
const siteStats = await getSiteStats();

function isActiveLink(linkHref: string): boolean {
  const path = Astro.url.pathname;
  if (linkHref === '/') return path === '/';
  // Tag pages are a view of the dispatches, and their breadcrumb says so.
  if (linkHref === '/posts/' && path.startsWith('/tags/')) return true;
  // PizzaOps is a Workbench project with its own page (design review 2026-10:
  // a visitor landing there had no "you are here" marker at all).
  if (linkHref === '/projects/' && path.startsWith('/pizza-ops/')) return true;
  return path.startsWith(linkHref);
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.author} />

    <!-- Security Headers -->
    <!-- 'unsafe-inline' in script-src is a deliberate, documented acceptance,
         not an oversight — see docs/security-posture.md. Astro's build-time CSP
         hashing does not cover `is:inline` scripts (it is told not to process
         them) and the theme-flash snippet below must run before first paint.
         The real defence against injected script is the rehype-sanitize pass in
         astro.config.mjs. Do not "fix" this without reading that doc. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'"
    />
    <!-- GitHub Pages can't send real response headers; only the CSP meta and referrer meta are effective here. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} Feed`} href={`${siteUrl}/feed.xml`} />
    <link rel="alternate" type="application/feed+json" title={`${siteTitle} JSON Feed`} href={`${siteUrl}/feed.json`} />

    <!-- Preconnect to external image hosts for faster LCP -->

    <!-- Self-hosted fonts (Astro Fonts API — see astro.config.mjs).
         Only the display face is preloaded; see the note below. -->
    {/* Only the display face is preloaded (issue #506, decided by consensus
        vote). <Font preload> preloads EVERY face in the family, so preloading
        both put 624,264 bytes on the critical path of all 210 pages — 100,980
        of it the Greek subset that 8 posts need.

        Fraunces is the masthead nameplate: above the fold on every page and
        the element the design actually rests on, so a swap there is visible.
        Source Serif 4 is body text, and Astro inlines metric-matched fallback
        @font-face blocks (size-adjust / ascent-override / descent-override)
        with font-display: swap, which is exactly the case metric matching
        exists for.

        This also retires the Greek problem without a second CSS variable: the
        non-preloaded faces keep their unicode-range descriptors, so the
        browser fetches the Greek subset only on pages whose text contains
        Greek glyphs. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-accent" /><!-- zine accent voice; deliberately not preloaded -->

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- theme-color must be a literal hex — browsers don't resolve CSS
         custom properties here. Keep in sync with --color-bg in global.css:
         light = oklch(0.95 0.015 75) -> #f5ede4, dark = oklch(0.14 0.015 140) -> #060b05.
         Recompute (OKLCH -> linear sRGB -> hex) whenever --color-bg changes.
         These are the no-JS defaults only: ThemeToggle.astro rewrites both
         to the live background whenever the mode or a deck theme changes. -->
    <meta name="theme-color" content="#f5ede4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060b05" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:title" content={title === 'Home' ? siteTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    {
      type === 'article' && publishedDate && (
        <>
          <meta property="article:author" content={SITE_CONFIG.author} />
          <meta property="article:published_time" content={publishedDate.toISOString()} />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === 'Home' ? siteTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Structured Data -->
    {/* Unicode-escape every `<` in the JSON-LD so a schema string field
        containing a closing script tag can't break out of the tag —
        JSON.stringify alone doesn't escape it.

        The set:html is deliberate and the input is ours: these are objects
        this component builds, serialised by JSON.stringify, with the one
        breakout character escaped above. Suppressed at the line rather than
        globally so `pnpm lint` can run at --max-warnings 0 and any NEW
        set:html still fails. */}
    {/* eslint-disable-next-line astro/no-set-html-directive */}
    {jsonLdSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}

    <!-- Theme deck (remarque-tokens 0.31 + oklch-terminal-themes): every
         palette in one stylesheet built by scripts/build-palette-deck.mjs.
         Each is inert ([data-palette]-scoped) until chosen and follows the
         light/dark toggle; :root:root[data-palette] outranks global.css. -->
    <link rel="stylesheet" href="/palettes/deck.css" />

    <!-- Theme + palette: apply saved preferences before first paint. The
         light/dark mode and the deck palette are independent now (palettes
         are paired), so both restore side by side. Readers of the old
         12-theme deck ("themeDeck" = "slug|mode") are migrated once: the
         slug maps to its paired palette (Dracula has no light theme in the
         dataset, so it falls back to the default) and the mode it forced
         becomes their light/dark preference, so nothing changes for them. -->
    <script is:inline>
      (function() {
        try {
          const root = document.documentElement;
          const legacy = localStorage.getItem('themeDeck');
          if (legacy) {
            const parts = legacy.split('|');
            const map = { nord: 'nord', 'nord-light': 'nord', 'catppuccin-mocha': 'catppuccin', 'catppuccin-latte': 'catppuccin',
              tokyonight: 'tokyonight', 'gruvbox-dark-hard': 'gruvbox', 'gruvbox-light-hard': 'gruvbox', 'kanagawa-wave': 'kanagawa',
              'rose-pine': 'rose-pine', 'solarized-dark-higher-contrast': 'solarized', 'github-light-default': 'github' };
            if (map[parts[0]]) localStorage.setItem('remarque-palette', map[parts[0]]);
            if ((parts[1] === 'dark' || parts[1] === 'light') && !localStorage.theme) localStorage.theme = parts[1];
            localStorage.removeItem('themeDeck');
          }
          const p = localStorage.getItem('remarque-palette');
          if (p) root.setAttribute('data-palette', p);
          const t = localStorage.theme;
          if (t === 'dark') root.classList.add('dark');
          else if (t === 'light') root.classList.add('light');
        } catch { /* storage blocked: fall back to the CSS media query */ }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-to-main">Skip to main content</a>

    <!-- Masthead -->
    <header id="top" role="banner" aria-label="Site header" class="site-masthead zine-grain wobble-rule">
      <div class="site-masthead-inner">
        <div class="site-masthead-top">
          <div class="site-masthead-tools-left" aria-hidden="true">
            {/* hand-drawn antenna mark — recolors with the active theme */}
            <div
              class="zine-doodle zine-doodle--accent"
              style="--doodle: url('/assets/doodles/corner-antenna.png'); width: 1.6rem; aspect-ratio: 154/240; transform: rotate(-4deg);"
            >
            </div>
          </div>
          <a href="/" class="site-nameplate" aria-label="William Zujkowski's Field Notes — home">
            <span class="site-nameplate-byline">William Zujkowski&rsquo;s</span>
            <span class="site-nameplate-title"><em>Field</em> Notes</span>
          </a>
          <div class="site-masthead-tools-right">
            <SearchTrigger />
            <ThemeDeck />
            <ThemeToggle />
          </div>
        </div>

        <nav class="site-sections" aria-label="Primary navigation">
          {
            SECTIONS.map((link) => (
              <a
                href={link.href}
                aria-current={isActiveLink(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <!-- Main -->
    {/* tabindex="-1": without it the skip link moves the sequential-focus
        STARTING POINT but not document.activeElement, so the screen-reader
        virtual cursor stays at the top of the page -- the documented
        Safari/VoiceOver and older-NVDA failure. axe cannot see this; it
        only checks that the target exists. */}
    <main id="main" tabindex="-1" data-pagefind-body={searchIndex && !noindex ? true : undefined}>
      <slot />
    </main>

    <!-- Footer -->
    <footer role="contentinfo" aria-label="Site footer" class="site-footer zine-grain">
      {/* A way back from the bottom of a long page (design review 2026-10:
          on mobile the TOC is not sticky, and a long post ends tens of
          thousands of px below the masthead). */}
      <nav class="footer-wayfinding" aria-label="Footer navigation">
        <a href="#top">Back to top ↑</a>
        <a href="/posts/">All dispatches</a>
      </nav>
      <p class="footer-links">
        <span class="footer-nowrap">&copy; {currentYear} William Zujkowski.</span>
        <span class="footer-nowrap"><a href={SITE_CONFIG.social.github}>GitHub</a></span>
        <span class="footer-nowrap"><span aria-hidden="true">&middot;</span> <a href={SITE_CONFIG.social.linkedin}>LinkedIn</a></span>
        <span class="footer-nowrap"><span aria-hidden="true">&middot;</span> <a href="/feed.xml">RSS</a></span>
      </p>
      <p class="footer-theme-credit">
        Terminal themes via <a href="https://github.com/williamzujkowski/oklch-terminal-themes">oklch&#8209;terminal&#8209;themes</a>
        (<a href="/about/#theme-credits">credits</a>).
      </p>
    </footer>

    <CodeCopy />
  </body>
</html>
