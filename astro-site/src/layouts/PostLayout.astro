---
import BaseLayout from './BaseLayout.astro';
import { SITE_CONFIG } from '@/lib/siteConfig';
import { humanTag } from '@/lib/utils';
import { getKickerTag } from '@/lib/posts';
import TableOfContents from '@components/TableOfContents.astro';
import RelatedPosts from '@components/RelatedPosts.astro';
import SeriesNav from '@components/SeriesNav.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import PostPager from '@components/PostPager.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  ogImage?: string;
  readingTime?: number;
  wordCount?: number;
  headings?: Heading[];
  currentId?: string;
  series?: string;
  postId?: string;
}

const { title, description, date, tags = [], ogImage, readingTime, wordCount, headings = [], currentId = '', series, postId } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE_CONFIG.siteUrl;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC', // dates are UTC-midnight; format in UTC so text matches <time datetime>
});

const primaryTag = await getKickerTag({ tags });
const section = primaryTag ? humanTag(primaryTag) : 'Essay';
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  type="article"
  publishedDate={date}
  wordCount={wordCount}
  tags={tags}
>
  <article class="post-article remarque-essay">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[{ label: 'Front', href: '/' }, { label: 'Dispatches', href: '/posts/' }, { label: title }]} />

    <!-- Header -->
    <header class="post-header">
      <p class="post-kicker" data-pagefind-ignore>
        <span class="post-section">{section}</span>
        {readingTime && (
          <>
            <span class="kicker-pair"><span class="dot" aria-hidden="true">·</span><span>{readingTime} min read</span></span>
          </>
        )}
        <span class="kicker-pair"><span class="dot" aria-hidden="true">·</span><time datetime={date.toISOString().split('T')[0]}>{formattedDate}</time></span>
      </p>

      <h1>{title}</h1>

      {description && <p class="post-description">{description}</p>}
    </header>

    <!-- Series Navigation -->
    {series && postId && <SeriesNav currentId={postId} series={series} />}

    <!-- Table of Contents -->
    <TableOfContents headings={headings} />

    <!-- Content -->
    <div class="prose remarque-prose remarque-prose--dropcap remarque-prose--external-marks">
      <slot />
      <div class="remarque-endmark" aria-hidden="true"></div>
    </div>

    <!-- Tags + share. The tag chips used to sit in the header, where at 360px
         they helped push every post's first paragraph off the first screen
         (#698); the kicker still names the primary tag up there. -->
    <footer class="post-footer">
      {
        tags.some((t) => t !== 'posts') && (
          <div class="post-footer-tags">
            <span class="share-label" id="post-tags-label">Tags:</span>
            <ul class="remarque-tags" aria-labelledby="post-tags-label">
              {tags
                .filter((t) => t !== 'posts')
                .map((tag) => (
                  <li>
                    <a href={`/tags/${tag}/`} class="chip" rel="tag">
                      {tag}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )
      }
      <details class="share-menu">
        <summary class="chip">Share</summary>
        <ul class="share-links">
          <li>
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`${siteUrl}${Astro.url.pathname}`)}&title=${encodeURIComponent(title)}`}
              class="chip"
              target="_blank"
              rel="noopener noreferrer"
            >LinkedIn</a>
          </li>
          <li>
            <a
              href={`https://news.ycombinator.com/submitlink?u=${encodeURIComponent(`${siteUrl}${Astro.url.pathname}`)}&t=${encodeURIComponent(title)}`}
              class="chip"
              target="_blank"
              rel="noopener noreferrer"
            >Hacker News</a>
          </li>
          <li>
            <a
              href={`https://www.reddit.com/submit?url=${encodeURIComponent(`${siteUrl}${Astro.url.pathname}`)}&title=${encodeURIComponent(title)}`}
              class="chip"
              target="_blank"
              rel="noopener noreferrer"
            >Reddit</a>
          </li>
        </ul>
      </details>
    </footer>

    <!-- Previous / next in date order -->
    <PostPager currentId={postId ?? currentId} series={series} />

    <!-- Related Posts -->
    <RelatedPosts currentId={currentId} tags={tags} />
  </article>
</BaseLayout>
