---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/posts';
import { countPostTags, postPieceNumbers, postsByUTCYear } from '@/lib/publication.mjs';
import BroadsheetEntry from '@components/BroadsheetEntry.astro';

const posts = await getPublishedPosts();

const tagCounts = countPostTags(posts);
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const pieceNumberById = postPieceNumbers(posts);
const postsByYear = postsByUTCYear(posts);
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="Blog"
  description="Security insights, AI experiments, homelab adventures, and lessons from the field."
  searchIndex={false}
>
  <h1 class="sr-only">Dispatches — every piece</h1>

  {/* dispatch en route — decorative, recolors with the active theme */}
  <div
    class="zine-doodle"
    aria-hidden="true"
    style="--doodle: url('/assets/doodles/spot-packet.png'); width: 150px; aspect-ratio: 420/250; margin: 0.5rem auto -0.25rem;"
  >
  </div>

  <div class="archive-intro">
    <p class="archive-stats">
      {posts.length} pieces
      <span class="dot">·</span>
      {years.length} years
      <span class="dot">·</span>
      {tagCounts.size} tags
    </p>
    <div class="archive-filter">
      {topTags.map(([tag, count]) => (
        <a href={`/tags/${tag}/`} class="chip">{tag}<sup>{count}</sup></a>
      ))}
      <a href="/tags/" class="chip">all tags</a>
    </div>
  </div>

  <section id="start-here" class="reading-paths prose" aria-labelledby="start-here-title">
    <h2 id="start-here-title">Start here</h2>
    <p>Two routes through the archive. Read in order, or pick the problem on your desk.</p>
    <h3>Securing agents</h3>
    <p>For readers comfortable with process isolation and API permissions.</p>
    <ol>
      <li><a href="/posts/2026-07-02-agentic-ai-sandbox-secret-proxying-gap/">Sandboxing and credential proxying</a> — start with what the agent can reach and which secrets it can see.</li>
      <li><a href="/posts/2026-07-30-prove-the-gate-not-the-agent/">Prove the execution gate</a> — follow the boundary from permissions to properties you can check.</li>
      <li><a href="/posts/2026-08-18-the-policy-is-the-part-that-moves/">When policy changes during a task</a> — examine what happens when yesterday's permission no longer applies.</li>
    </ol>
    <h3>Homelab security</h3>
    <p>Start with basic networking; the later articles assume familiarity with Linux services. These are dated field notes, so check current upstream documentation before applying commands.</p>
    <ol>
      <li><a href="/posts/2025-09-08-zero-trust-vlan-segmentation-homelab/">Separate trust zones with VLANs</a> — decide which devices should be able to talk before adding monitoring.</li>
      <li><a href="/posts/2025-08-25-network-traffic-analysis-suricata-homelab/">Inspect traffic with Suricata</a> — make network activity visible inside those boundaries.</li>
      <li><a href="/posts/2025-12-10-homelab-security-dashboard-grafana-prometheus/">Build a security dashboard</a> — bring the resulting signals together for investigation.</li>
    </ol>
  </section>

  {years.map((year) => (
    <section class="year-section">
      <h2 class="year-divider">
        <span class="year-number">{year}</span>
        <span class="year-rule" aria-hidden="true"></span>
        <span class="year-count">{postsByYear.get(year)!.length} entries</span>
      </h2>
      <ol class="entry-list">
        {postsByYear.get(year)!.map((post) => (
          <BroadsheetEntry post={post} variant="entry" number={pieceNumberById.get(post.id)!} />
        ))}
      </ol>
    </section>
  ))}
</BaseLayout>

<style>
  .reading-paths {
    max-width: var(--content-reading);
    margin: var(--space-6) auto;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }
  .year-section {
    max-width: var(--content-reading);
    margin: 0 auto;
    padding-block: var(--space-6);
  }
  .year-divider {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    margin: 0 0 var(--space-4);
    font-weight: 400;
    border: 0;
  }
  .year-number {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--color-fg);
    letter-spacing: -0.02em;
    font-variant-numeric: oldstyle-nums proportional-nums;
    font-feature-settings: "onum" 1, "pnum" 1;
  }
  .year-rule {
    height: 1px;
    background: var(--color-border);
    align-self: center;
  }
  .year-count {
    /* font-family: mono — shared machine-voice rule in global.css (#274) */
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
