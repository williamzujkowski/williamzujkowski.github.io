---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/posts';
import { countPostTags } from '@/lib/publication.mjs';
import Breadcrumb from '@components/Breadcrumb.astro';

const posts = await getPublishedPosts();

const tagCounts = countPostTags(posts);

// Most-used first; equal counts fall back to alphabetical so the order is
// stable and the rows read as a ranked list, not a shuffle.
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout searchIndex={false} title="Tags" description="Browse all blog post tags.">
  <Breadcrumb items={[{ label: 'Front', href: '/' }, { label: 'Dispatches', href: '/posts/' }, { label: 'Tags' }]} />
  <div class="prose">
    <h1>Tags</h1>
    <p>{sortedTags.length} tags across {posts.length} posts.</p>
  </div>

  <ul class="remarque-tags tag-index" aria-label="All tags">
    {
      sortedTags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`} class="chip" rel="tag">
            {tag}<span class="tag-count">{count}<span class="sr-only"> posts</span></span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
