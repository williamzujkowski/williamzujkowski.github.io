---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/posts';
import { countPostTags } from '@/lib/publication.mjs';

const posts = await getPublishedPosts();

const tagCounts = countPostTags(posts);

// Sort by count descending
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout searchIndex={false} title="Tags" description="Browse all blog post tags.">
  <div class="prose">
    <h1>Tags</h1>
    <p>{sortedTags.length} tags across {posts.length} posts.</p>
  </div>

  <div class="chip-row">
    {
      sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}/`} class="chip">
          {tag}<sup>{count}</sup>
        </a>
      ))
    }
  </div>
</BaseLayout>
