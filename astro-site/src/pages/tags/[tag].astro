---
import { humanTag } from '@/lib/utils';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/posts';
import { countPostTags, postPieceNumbers } from '@/lib/publication.mjs';
import BroadsheetEntry from '@components/BroadsheetEntry.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

export async function getStaticPaths() {
  const sortedAll = await getPublishedPosts();
  const pieceById = postPieceNumbers(sortedAll);
  const tags = countPostTags(sortedAll).keys();

  return [...tags].map((tag) => {
    const filtered = sortedAll.filter((p) => p.data.tags?.includes(tag));
    return {
      params: { tag },
      props: {
        tag,
        posts: filtered.map((post) => ({ post, piece: pieceById.get(post.id)! })),
      },
    };
  });
}

const { tag, posts } = Astro.props;
const humanTagLabel = humanTag(tag);
---

<BaseLayout searchIndex={false} title={`Posts tagged "${tag}"`} description={`All blog posts tagged with "${tag}".`}>
  <Breadcrumb items={[{ label: 'Front', href: '/' }, { label: 'Dispatches', href: '/posts/' }, { label: 'Tags', href: '/tags/' }, { label: tag }]} />

  <header class="tag-header">
    <p class="masthead-kicker tag-kicker">Filed under</p>
    <h1 class="tag-title">
      <em>{humanTagLabel}</em>
    </h1>
    <p class="masthead-dateline">
      {posts.length} {posts.length === 1 ? 'entry' : 'entries'}
    </p>
  </header>

  <ol class="entry-list">
    {posts.map(({ post, piece }) => (
      <BroadsheetEntry post={post} variant="entry" number={piece} headingLevel={2} />
    ))}
  </ol>
</BaseLayout>

<style>
  /* One page-title rung (--text-display, as on every page), left-aligned in
     the reading column. The tag name stays italic: the zine layer's accent,
     and the only thing distinguishing a landing from a list. */
  .tag-header {
    max-width: var(--content-reading);
    margin: var(--space-5) auto var(--space-6);
  }
  .tag-title {
    margin-block: 0;
  }
  .tag-title em { font-style: italic; font-weight: 300; }
  .tag-header .masthead-kicker,
  .tag-header .masthead-dateline { justify-content: flex-start; }
</style>
